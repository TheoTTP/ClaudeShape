{
  "name": "claudeshape",
  "version": "0.1.0",
  "description": "Prompt Claude to model parts in Onshape",
  "main": "server.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "start": "node server.js",
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/test-builders.mjs && node scripts/smoke.mjs && node scripts/smoke-mcp.mjs && node scripts/smoke-gui.mjs && node scripts/test-update.mjs && node scripts/test-claude-bin.mjs",
    "setup": "node scripts/setup.mjs",
    "mcp": "node mcp.js",
    "gui": "node gui.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheoTTP/ClaudeShape.git"
  },
  "bugs": {
    "url": "https://github.com/TheoTTP/ClaudeShape/issues"
  },
  "homepage": "https://github.com/TheoTTP/ClaudeShape#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cookie-session": "^2.1.1",
    "express": "^5.3.0",
    "opentype.js": "^2.0.0"
  },
  "type": "module",
  "bin": {
    "claudeshape": "mcp.js"
  }
}
